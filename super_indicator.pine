//@version=5
indicator("Super Indicator", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=1000)

minConf   = input.float(30.0, "Min confidence %", minval=0.0, maxval=100.0, step=1.0)
minScore  = input.float(0.45, "Min net score", minval=0.0, step=0.05)
minVoters = input.int(4, "Min active voters", minval=1, maxval=12)
showLvls  = input.bool(true, "Draw Entry / SL / TP")
slMin     = input.float(0.75, "SL min x ATR", minval=0.1, step=0.05)
slMax     = input.float(2.00, "SL max x ATR", minval=0.1, step=0.05)
liqAbove  = input.float(0.0, "Liq cluster above (optional)")
liqBelow  = input.float(0.0, "Liq cluster below (optional)")

wRSI    = 0.9
wEMA    = 0.8
wMACD   = 0.7
wStruct = 0.7
wVWAP   = 0.6
wLiq    = 0.6
wOB     = 0.6
wTrend  = 0.6
wBB     = 0.5
wStoch  = 0.5
wFVG    = 0.5
wVP     = 0.5

rsiV = ta.rsi(close, 14)
float v1d = 0.0
float v1w = 0.0
if not na(rsiV)
    if rsiV >= 70
        v1d := -1.0
        v1w := wRSI
    else if rsiV <= 30
        v1d := 1.0
        v1w := wRSI
    else if rsiV > 60
        v1d := -0.4
        v1w := wRSI * 0.4444
    else if rsiV < 40
        v1d := 0.4
        v1w := wRSI * 0.4444

eFast = ta.ema(close, 20)
eSlow = ta.ema(close, 50)
float v2d = 0.0
float v2w = 0.0
if not na(eFast) and not na(eSlow)
    if close > eFast and eFast > eSlow
        v2d := 1.0
        v2w := wEMA
    else if close < eFast and eFast < eSlow
        v2d := -1.0
        v2w := wEMA
    else if close > eSlow
        v2d := 0.4
        v2w := wEMA * 0.5
    else
        v2d := -0.4
        v2w := wEMA * 0.5

[macdLine, macdSig, macdHist] = ta.macd(close, 12, 26, 9)
float v3d = 0.0
float v3w = 0.0
if not na(macdHist) and not na(macdLine) and not na(macdSig)
    if macdHist > 0 and macdLine > macdSig
        v3d := 0.8
        v3w := wMACD
    else if macdHist < 0 and macdLine < macdSig
        v3d := -0.8
        v3w := wMACD

swHigh = ta.pivothigh(high, 5, 5)
swLow  = ta.pivotlow(low, 5, 5)
var float lastHigh = na
var float lastLow  = na
if not na(swHigh)
    lastHigh := swHigh
if not na(swLow)
    lastLow := swLow
float v4d = 0.0
float v4w = 0.0
if not na(lastHigh) and not na(lastLow)
    if close > lastHigh
        v4d := 0.8
        v4w := wStruct
    else if close < lastLow
        v4d := -0.8
        v4w := wStruct

vwapRoll = ta.sma(hlc3 * volume, 48) / ta.sma(volume, 48)
float v5d = 0.0
float v5w = 0.0
if not na(vwapRoll) and vwapRoll > 0
    dev = (close - vwapRoll) / vwapRoll * 100
    if dev < -1.0
        v5d := 1.0
        v5w := wVWAP
    else if dev > 1.0
        v5d := -1.0
        v5w := wVWAP

float v6d = 0.0
float v6w = 0.0
if liqAbove > 0 and liqBelow > 0 and liqAbove > close and liqBelow < close
    if (liqAbove - close) < (close - liqBelow)
        v6d := 1.0
        v6w := wLiq
    else
        v6d := -1.0
        v6w := wLiq
else if liqAbove > 0 and liqAbove > close
    v6d := 1.0
    v6w := wLiq
else if liqBelow > 0 and liqBelow < close
    v6d := -1.0
    v6w := wLiq

avgBody = ta.sma(math.abs(close - open), 20)
float obLo = na
float obHi = na
float obDir = 0.0
if not na(avgBody) and avgBody > 0 and bar_index > 62
    for i = 1 to 40
        if math.abs(close[i] - open[i]) < avgBody
            if close[i] < open[i] and (close[i - 1] - open[i - 1]) > 1.5 * avgBody
                obLo := low[i]
                obHi := high[i]
                obDir := 1.0
                break
            if close[i] > open[i] and (open[i - 1] - close[i - 1]) > 1.5 * avgBody
                obLo := low[i]
                obHi := high[i]
                obDir := -1.0
                break
float v7d = 0.0
float v7w = 0.0
if obDir > 0 and not na(obLo)
    if close >= obLo
        v7d := 0.6
        v7w := wOB
    else
        v7d := 0.3
        v7w := wOB * 0.5
if obDir < 0 and not na(obHi)
    if close <= obHi
        v7d := -0.6
        v7w := wOB
    else
        v7d := -0.3
        v7w := wOB * 0.5

lr0 = ta.linreg(close, 60, 0)
lr1 = ta.linreg(close, 60, 1)
slope = lr0 - lr1
float v8d = 0.0
float v8w = 0.0
if not na(slope) and close > 0
    norm = slope / close * 100
    if norm > 0.05
        v8d := 0.7
        v8w := wTrend
    else if norm < -0.05
        v8d := -0.7
        v8w := wTrend

bbBasis = ta.sma(close, 20)
bbDev   = 2.0 * ta.stdev(close, 20)
bbUp    = bbBasis + bbDev
bbLo    = bbBasis - bbDev
float v9d = 0.0
float v9w = 0.0
if not na(bbUp) and not na(bbLo) and bbUp > bbLo
    if close <= bbLo
        v9d := 1.0
        v9w := wBB
    else if close >= bbUp
        v9d := -1.0
        v9w := wBB

stK = ta.sma(ta.stoch(close, high, low, 14), 3)
stD = ta.sma(stK, 3)
float v10d = 0.0
float v10w = 0.0
if not na(stK) and not na(stD)
    if stK < 20 and stK > stD
        v10d := 1.0
        v10w := wStoch
    else if stK > 80 and stK < stD
        v10d := -1.0
        v10w := wStoch

float fvgLo = na
float fvgHi = na
float fvgDir = 0.0
if bar_index > 32
    for i = 1 to 30
        if high[i + 1] < low[i - 1]
            fvgLo := high[i + 1]
            fvgHi := low[i - 1]
            fvgDir := 1.0
            break
        if low[i + 1] > high[i - 1]
            fvgLo := high[i - 1]
            fvgHi := low[i + 1]
            fvgDir := -1.0
            break
float v11d = 0.0
float v11w = 0.0
if fvgDir > 0 and not na(fvgHi)
    if close >= fvgHi
        v11d := 0.6
        v11w := wFVG
    else
        v11d := 0.3
        v11w := wFVG * 0.6
if fvgDir < 0 and not na(fvgLo)
    if close <= fvgLo
        v11d := -0.6
        v11w := wFVG
    else
        v11d := -0.3
        v11w := wFVG * 0.6

var array<float> vpVols = array.new_float(40, 0.0)
float pocVal = na
float vaLow = na
float vaHigh = na
if bar_index >= 200
    float hiW = high
    float loW = low
    for i = 0 to 199
        hiW := math.max(hiW, high[i])
        loW := math.min(loW, low[i])
    if hiW > loW
        step = (hiW - loW) / 40
        array.fill(vpVols, 0.0)
        for i = 0 to 199
            mid = (high[i] + low[i]) / 2
            idx = math.max(0, math.min(int((mid - loW) / step), 39))
            array.set(vpVols, idx, array.get(vpVols, idx) + nz(volume[i]))
        pocIdx = array.indexof(vpVols, array.max(vpVols))
        pocVal := loW + (pocIdx + 0.5) * step
        total = array.sum(vpVols)
        acc = array.get(vpVols, pocIdx)
        int loI = pocIdx
        int hiI = pocIdx
        while acc < 0.7 * total and (loI > 0 or hiI < 39)
            up = hiI < 39 ? array.get(vpVols, hiI + 1) : -1.0
            dn = loI > 0 ? array.get(vpVols, loI - 1) : -1.0
            if up >= dn
                hiI := hiI + 1
                acc := acc + math.max(up, 0)
            else
                loI := loI - 1
                acc := acc + math.max(dn, 0)
        vaLow := loW + loI * step
        vaHigh := loW + (hiI + 1) * step
float v12d = 0.0
float v12w = 0.0
if not na(pocVal) and not na(vaHigh) and not na(vaLow)
    if close > vaHigh
        v12d := 0.7
        v12w := wVP
    else if close < vaLow
        v12d := -0.7
        v12w := wVP

num = (v1d * v1w + v2d * v2w + v3d * v3w + v4d * v4w + v5d * v5w + v6d * v6w
     + v7d * v7w + v8d * v8w + v9d * v9w + v10d * v10w + v11d * v11w + v12d * v12w)
den = ((v1w > 0 ? v1w : 0) + (v2w > 0 ? v2w : 0) + (v3w > 0 ? v3w : 0)
     + (v4w > 0 ? v4w : 0) + (v5w > 0 ? v5w : 0) + (v6w > 0 ? v6w : 0)
     + (v7w > 0 ? v7w : 0) + (v8w > 0 ? v8w : 0) + (v9w > 0 ? v9w : 0)
     + (v10w > 0 ? v10w : 0) + (v11w > 0 ? v11w : 0) + (v12w > 0 ? v12w : 0))
speakers = ((v1w > 0 ? 1 : 0) + (v2w > 0 ? 1 : 0) + (v3w > 0 ? 1 : 0)
     + (v4w > 0 ? 1 : 0) + (v5w > 0 ? 1 : 0) + (v6w > 0 ? 1 : 0)
     + (v7w > 0 ? 1 : 0) + (v8w > 0 ? 1 : 0) + (v9w > 0 ? 1 : 0)
     + (v10w > 0 ? 1 : 0) + (v11w > 0 ? 1 : 0) + (v12w > 0 ? 1 : 0))

conf   = den > 0 ? math.abs(num) / den * 100 : 0.0
ok     = conf >= minConf and math.abs(num) >= minScore and speakers >= minVoters
signal = ok ? (num > 0 ? 1 : num < 0 ? -1 : 0) : 0

atrV  = ta.atr(14)
entry = close
supLvl = not na(lastLow)  and lastLow  < close ? lastLow  : na
resLvl = not na(lastHigh) and lastHigh > close ? lastHigh : na

float slLvl = na
if signal == 1 and not na(atrV)
    rawSl = na(supLvl) ? entry - 1.5 * atrV : math.min(supLvl, entry - slMin * atrV)
    slLvl := math.max(rawSl, entry - slMax * atrV)
if signal == -1 and not na(atrV)
    rawSl = na(resLvl) ? entry + 1.5 * atrV : math.max(resLvl, entry + slMin * atrV)
    slLvl := math.min(rawSl, entry + slMax * atrV)

risk = na(slLvl) ? na : math.abs(entry - slLvl)
tp1 = na(risk) ? na : (signal == 1 ? entry + 2 * risk : entry - 2 * risk)
tp2 = na(risk) ? na : (signal == 1 ? entry + 3 * risk : entry - 3 * risk)
tp3 = na(risk) ? na : (signal == 1 ? entry + 4 * risk : entry - 4 * risk)
tp4 = na(risk) ? na : (signal == 1 ? entry + 5 * risk : entry - 5 * risk)

plot(eFast,    "EMA 20", color=color.new(color.blue, 0))
plot(eSlow,    "EMA 50", color=color.new(color.red, 0))
plot(vwapRoll, "VWAP",   color=color.new(color.white, 0), linewidth=2)
plot(bbUp,     "BB upper", color=color.new(color.gray, 60))
plot(bbLo,     "BB lower", color=color.new(color.gray, 60))

bgcolor(signal == 1 ? color.new(color.green, 88) : signal == -1 ? color.new(color.red, 88) : na)

newBuy  = signal == 1  and nz(signal[1], 0) != 1
newSell = signal == -1 and nz(signal[1], 0) != -1
plotshape(newBuy,  "BUY",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(newSell, "SELL", shape.triangledown, location.abovebar, color.red,   size=size.small)

if showLvls and signal != 0 and not na(slLvl)
    line.new(bar_index, slLvl, bar_index + 1, slLvl, color=color.red,   width=2)
    line.new(bar_index, entry, bar_index + 1, entry, color=color.blue,  width=2, style=line.style_dashed)
    line.new(bar_index, tp1,   bar_index + 1, tp1,   color=color.green, width=1, style=line.style_dotted)
    line.new(bar_index, tp2,   bar_index + 1, tp2,   color=color.green, width=1, style=line.style_dotted)
    line.new(bar_index, tp3,   bar_index + 1, tp3,   color=color.green, width=1, style=line.style_dotted)
    line.new(bar_index, tp4,   bar_index + 1, tp4,   color=color.green, width=1, style=line.style_dotted)

var table info = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    dirStr = signal == 1 ? "BUY" : signal == -1 ? "SELL" : "NO TRADE"
    table.cell(info, 0, 0, "SUPER INDICATOR", bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, dirStr, bgcolor=signal == 1 ? color.green : signal == -1 ? color.red : color.gray, text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "Confidence", text_size=size.small)
    table.cell(info, 1, 1, str.tostring(conf, "#.0") + "%", text_size=size.small)
    table.cell(info, 0, 2, "Net score", text_size=size.small)
    table.cell(info, 1, 2, str.tostring(num, "#.00"), text_size=size.small)
    table.cell(info, 0, 3, "Voters active", text_size=size.small)
    table.cell(info, 1, 3, str.tostring(speakers), text_size=size.small)
    table.cell(info, 0, 4, "Entry / SL", text_size=size.small)
    table.cell(info, 1, 4, na(slLvl) ? "-" : str.tostring(entry, format.mintick) + " / " + str.tostring(slLvl, format.mintick), text_size=size.small)
    table.cell(info, 0, 5, "TP1 / TP2", text_size=size.small)
    table.cell(info, 1, 5, na(tp1) ? "-" : str.tostring(tp1, format.mintick) + " / " + str.tostring(tp2, format.mintick), text_size=size.small)
    table.cell(info, 0, 6, "TP3 / TP4", text_size=size.small)
    table.cell(info, 1, 6, na(tp3) ? "-" : str.tostring(tp3, format.mintick) + " / " + str.tostring(tp4, format.mintick), text_size=size.small)
    table.cell(info, 0, 7, "ATR(14)", text_size=size.small)
    table.cell(info, 1, 7, na(atrV) ? "-" : str.tostring(atrV, format.mintick), text_size=size.small)

alertcondition(newBuy,  "Super BUY",  "Super Indicator BUY")
alertcondition(newSell, "Super SELL", "Super Indicator SELL")
