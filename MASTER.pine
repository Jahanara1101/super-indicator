//@version=6
indicator("MASTER - SMC + Patterns + Volume", "MASTER", overlay=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ARCHITECTURE
//   Pass 1 (every bar): detect events into flat state arrays. Nothing drawn.
//   Pass 2 (last bar): wipe every drawing and rebuild from the state arrays.
//   Rebuilding instead of appending keeps the object count inside
//   TradingView's per-type limits and stops zones being redrawn every tick.

// PALETTE - THREE colours only: red, green, white.
// Nothing else is allowed anywhere in the script, so there is no blue, no
// orange, no grey and no amber left to clash with anything else on the chart.
// Every fill is the same hue at high transparency, which is what keeps the
// candles readable.
COL_RED   = #F23645
COL_GREEN = #089981
COL_WHITE = #FFFFFF

// INPUTS
gS = "1 - Structure"
pivLen  = input.int(5, "Swing pivot length", minval=1, maxval=50, group=gS)
pivInt  = input.int(2, "Internal pivot length", minval=1, maxval=20, group=gS)
eqTol   = input.float(0.10, "Equal high/low tolerance (x ATR)", minval=0.01, maxval=0.5, step=0.01, group=gS)
maxKeep = input.int(6, "Structure levels kept", minval=1, maxval=20, group=gS)

gM = "2 - Market structure  (turn each on/off)"
showBOS     = input.bool(true, "BOS", group=gM)
showCHoCH   = input.bool(true, "CHoCH", group=gM)
showEQH     = input.bool(true, "EQH - equal highs", group=gM)
showEQL     = input.bool(true, "EQL - equal lows", group=gM)
showSWHigh  = input.bool(true, "Strong / Weak High", group=gM)
showSWLow   = input.bool(true, "Strong / Weak Low", group=gM)
showInt     = input.bool(true, "Internal structure (dashed, tiny)", group=gM)

gZ = "3 - Zones  (turn each on/off)"
showSD  = input.bool(true, "Supply & Demand", group=gZ)
showFVG = input.bool(true, "Fair Value Gaps (FVG)", group=gZ)
showOB  = input.bool(true, "Order Blocks (ODB)", group=gZ)
showLQZ = input.bool(true, "Liquidity Zones (Liq)", group=gZ)
zoneExt = input.int(15, "Zone extension (bars)", minval=2, maxval=300, group=gZ)
maxZ    = input.int(6, "Zones kept per type", minval=1, maxval=30, group=gZ)

gF = "4 - Premium / Discount + OTE"
showFib   = input.bool(true, "Premium / Discount zones", group=gF)
showOTE   = input.bool(true, "OTE band (0.62 - 0.79)", group=gF)
showFibSD = input.bool(false, "Standard-deviation targets (-0.5 / -1 / -1.5)", group=gF)
fibLo     = input.float(0.620, "OTE lower", minval=0.0, maxval=1.0, step=0.001, group=gF)
fibHi     = input.float(0.790, "OTE upper", minval=0.0, maxval=1.0, step=0.001, group=gF)

gP = "5 - Patterns"
showPat = input.bool(true, "Draw chart patterns", group=gP)
patFam  = input.string("All", "Pattern family", options=["All", "Reversal", "Triangle / Wedge", "Flag"], group=gP)
patTol  = input.float(0.35, "Equal-level tolerance (x ATR)", minval=0.05, maxval=2.0, step=0.05, group=gP)
patMinH = input.float(1.2, "Minimum pattern height (x ATR)", minval=0.2, maxval=10.0, step=0.1, group=gP)
maxPat  = input.int(4, "Patterns kept", minval=1, maxval=10, group=gP)

gV = "6 - Volume"
showVol  = input.bool(true, "Volume columns (buy green / sell red)", group=gV)
showVolMa= input.bool(true, "Volume average line", group=gV)
volMaLen = input.int(20, "Volume average length", minval=2, maxval=200, group=gV)

// VOLUME PANE - buy volume green, sell volume red
volMa  = ta.sma(volume, volMaLen)
volCol = close >= open ? color.new(COL_GREEN, 45) : color.new(COL_RED, 45)
plot(showVol ? volume : na, "Volume", color=volCol, style=plot.style_columns)
plot(showVol and showVolMa ? volMa : na, "Volume avg", color=color.new(COL_WHITE, 20), linewidth=1)

atr = ta.atr(14)

// DRAWING POOLS
var array<box>   gBox = array.new_box()
var array<line>  gLin = array.new_line()
var array<label> gLab = array.new_label()

// No borders anywhere - Noman asked for borderless rectangles.
f_box(left, top, right, bottom, bg) =>
    b = box.new(left, top, right, bottom, bgcolor=bg, border_color=color(na), border_width=0, force_overlay=true)
    array.push(gBox, b)
    b

f_line(x1, y1, x2, y2, col, sty, w) =>
    l = line.new(x1, y1, x2, y2, color=col, style=sty, width=w, force_overlay=true)
    array.push(gLin, l)
    l

f_lab(x, y, txt, col, sty, sz) =>
    lb = label.new(x, y, txt, color=color(na), textcolor=col, style=sty, size=sz, force_overlay=true)
    array.push(gLab, lb)
    lb

f_clearAll() =>
    while array.size(gBox) > 0
        box.delete(array.pop(gBox))
    while array.size(gLin) > 0
        line.delete(array.pop(gLin))
    while array.size(gLab) > 0
        label.delete(array.pop(gLab))
    true

f_zone(left, top, right, bottom, txt, col) =>
    if right > left
        f_lab(math.round((left + right) / 2), (top + bottom) / 2, txt, color.new(col, 20), label.style_label_center, size.small)
    true

// STATE - swing structure
var array<int>   swX = array.new_int()
var array<float> swY = array.new_float()
var array<int>   swD = array.new_int()

var array<int>   bX1 = array.new_int()
var array<float> bY = array.new_float()
var array<int>   bX2 = array.new_int()
var array<int>   bKind = array.new_int()
var array<int>   bDir = array.new_int()

// STATE - internal structure
var array<int>   iX1 = array.new_int()
var array<float> iY = array.new_float()
var array<int>   iX2 = array.new_int()
var array<int>   iKind = array.new_int()
var array<int>   iDir = array.new_int()

var array<int>   fX1 = array.new_int()
var array<float> fT = array.new_float()
var array<float> fB = array.new_float()

var array<int>   oX1 = array.new_int()
var array<float> oT = array.new_float()
var array<float> oB = array.new_float()

var array<int>   sX1 = array.new_int()
var array<float> sT = array.new_float()
var array<float> sB = array.new_float()
var array<int>   sD = array.new_int()

var int lastSdBar = -999

// PATTERN STATE - vertices only, no trade plan any more
var array<int>   pId = array.new_int()
var array<int>   pKind = array.new_int()
var array<int>   pN = array.new_int()
var array<int>   pX1 = array.new_int()
var array<int>   pX2 = array.new_int()
var array<int>   pX3 = array.new_int()
var array<int>   pX4 = array.new_int()
var array<int>   pX5 = array.new_int()
var array<float> pY1 = array.new_float()
var array<float> pY2 = array.new_float()
var array<float> pY3 = array.new_float()
var array<float> pY4 = array.new_float()
var array<float> pY5 = array.new_float()

f_pushPat(id, kind, n, x1, y1, x2, y2, x3, y3, x4, y4, x5, y5) =>
    array.push(pId, id)
    array.push(pKind, kind)
    array.push(pN, n)
    array.push(pX1, x1), array.push(pY1, y1)
    array.push(pX2, x2), array.push(pY2, y2)
    array.push(pX3, x3), array.push(pY3, y3)
    array.push(pX4, x4), array.push(pY4, y4)
    array.push(pX5, x5), array.push(pY5, y5)
    while array.size(pId) > maxPat
        array.shift(pId), array.shift(pKind), array.shift(pN)
        array.shift(pX1), array.shift(pY1), array.shift(pX2), array.shift(pY2)
        array.shift(pX3), array.shift(pY3), array.shift(pX4), array.shift(pY4)
        array.shift(pX5), array.shift(pY5)
    true

// PASS 1 - DETECTION
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
newPivot = not na(ph) or not na(pl)

// internal pivots feed ONLY the internal layer
phi = ta.pivothigh(high, pivInt, pivInt)
pli = ta.pivotlow(low, pivInt, pivInt)

if newPivot
    if not na(ph)
        array.push(swX, bar_index - pivLen), array.push(swY, ph), array.push(swD, 1)
    else
        array.push(swX, bar_index - pivLen), array.push(swY, pl), array.push(swD, -1)
    while array.size(swX) > 40
        array.shift(swX), array.shift(swY), array.shift(swD)

var float lastH = na
var int   lastHx = na
var float lastL = na
var int   lastLx = na
var int   trend = 0
var int   hTaken = -1
var int   lTaken = -1

if newPivot
    if not na(ph)
        lastH := ph
        lastHx := bar_index - pivLen
    if not na(pl)
        lastL := pl
        lastLx := bar_index - pivLen

upBreak = not na(lastH) and close > lastH and hTaken != lastHx
dnBreak = not na(lastL) and close < lastL and lTaken != lastLx

if upBreak
    bool cont = trend == 1
    hTaken := lastHx
    array.push(bX1, lastHx), array.push(bY, lastH), array.push(bX2, bar_index)
    array.push(bKind, cont ? 1 : 2), array.push(bDir, 1)
    while array.size(bX1) > maxKeep
        array.shift(bX1), array.shift(bY), array.shift(bX2), array.shift(bKind), array.shift(bDir)
    int obi = na
    for k = 1 to 25
        if close[k] < open[k]
            obi := k
            break
    if showOB and not na(obi)
        array.push(oX1, bar_index - obi), array.push(oT, high[obi]), array.push(oB, low[obi])
        while array.size(oX1) > maxZ
            array.shift(oX1), array.shift(oT), array.shift(oB)
    trend := 1

if dnBreak
    bool cont = trend == -1
    lTaken := lastLx
    array.push(bX1, lastLx), array.push(bY, lastL), array.push(bX2, bar_index)
    array.push(bKind, cont ? 1 : 2), array.push(bDir, -1)
    while array.size(bX1) > maxKeep
        array.shift(bX1), array.shift(bY), array.shift(bX2), array.shift(bKind), array.shift(bDir)
    int obi = na
    for k = 1 to 25
        if close[k] > open[k]
            obi := k
            break
    if showOB and not na(obi)
        array.push(oX1, bar_index - obi), array.push(oT, high[obi]), array.push(oB, low[obi])
        while array.size(oX1) > maxZ
            array.shift(oX1), array.shift(oT), array.shift(oB)
    trend := -1

// internal structure: its own pivots, its own trend, its own levels
var float iLastH = na
var int   iLastHx = na
var float iLastL = na
var int   iLastLx = na
var int   iTrend = 0
var int   iHTaken = -1
var int   iLTaken = -1

if not na(phi)
    iLastH := phi
    iLastHx := bar_index - pivInt
if not na(pli)
    iLastL := pli
    iLastLx := bar_index - pivInt

iUp = not na(iLastH) and close > iLastH and iHTaken != iLastHx
iDn = not na(iLastL) and close < iLastL and iLTaken != iLastLx

if iUp
    bool cont = iTrend == 1
    iHTaken := iLastHx
    array.push(iX1, iLastHx), array.push(iY, iLastH), array.push(iX2, bar_index)
    array.push(iKind, cont ? 1 : 2), array.push(iDir, 1)
    while array.size(iX1) > maxKeep
        array.shift(iX1), array.shift(iY), array.shift(iX2), array.shift(iKind), array.shift(iDir)
    iTrend := 1
if iDn
    bool cont = iTrend == -1
    iLTaken := iLastLx
    array.push(iX1, iLastLx), array.push(iY, iLastL), array.push(iX2, bar_index)
    array.push(iKind, cont ? 1 : 2), array.push(iDir, -1)
    while array.size(iX1) > maxKeep
        array.shift(iX1), array.shift(iY), array.shift(iX2), array.shift(iKind), array.shift(iDir)
    iTrend := -1

// trailing extremes - where the Strong/Weak labels sit
var float trTop = na
var int   trTopX = na
var float trBot = na
var int   trBotX = na

if newPivot
    if not na(ph)
        trTop := ph
        trTopX := bar_index - pivLen
    if not na(pl)
        trBot := pl
        trBotX := bar_index - pivLen
if na(trTop) or high > trTop
    trTop := high
    trTopX := bar_index
if na(trBot) or low < trBot
    trBot := low
    trBotX := bar_index

// Fair value gaps
if low > high[2] and close[1] > open[1]
    array.push(fX1, bar_index - 2), array.push(fT, low), array.push(fB, high[2])
    while array.size(fX1) > maxZ
        array.shift(fX1), array.shift(fT), array.shift(fB)
if high < low[2] and close[1] < open[1]
    array.push(fX1, bar_index - 2), array.push(fT, low[2]), array.push(fB, high)
    while array.size(fX1) > maxZ
        array.shift(fX1), array.shift(fT), array.shift(fB)

// Supply & demand
baseLen = 6
if not na(atr) and math.abs(close - close[baseLen]) > 2.0 * atr and bar_index - lastSdBar > baseLen + 5
    float bT = high[1]
    float bB = low[1]
    for k = 1 to baseLen
        bT := math.max(bT, high[k])
        bB := math.min(bB, low[k])
    bool up = close > close[baseLen]
    array.push(sX1, bar_index - baseLen), array.push(sT, bT), array.push(sB, bB), array.push(sD, up ? 1 : -1)
    lastSdBar := bar_index
    while array.size(sX1) > maxZ
        array.shift(sX1), array.shift(sT), array.shift(sB), array.shift(sD)

// PATTERNS
f_slope(array<int> xs, array<float> ys) =>
    int n = array.size(xs)
    float sx = 0.0
    float sy = 0.0
    float sxx = 0.0
    float sxy = 0.0
    for i = 0 to n - 1
        float x = array.get(xs, i)
        float y = array.get(ys, i)
        sx += x
        sy += y
        sxx += x * x
        sxy += x * y
    float den = n * sxx - sx * sx
    den == 0 ? 0.0 : (n * sxy - sx * sy) / den

f_patName(int id) =>
    switch id
        1  => "Ascending Triangle"
        2  => "Bullish Wedge"
        3  => "Bullish Flag"
        4  => "Bullish Symmetrical Triangle"
        5  => "Descending Triangle"
        6  => "Bearish Wedge"
        7  => "Bearish Flag"
        8  => "Bearish Symmetrical Triangle"
        9  => "Double Bottom"
        10 => "Triple Bottom"
        11 => "Inverted H&S"
        12 => "Falling Wedge"
        13 => "Double Top"
        14 => "Triple Top"
        15 => "Head & Shoulder"
        => "Rising Wedge"

// pattern family, so the family filter can be honoured
f_patFam(int id) =>
    id == 3 or id == 7 ? "Flag" : id >= 9 ? "Reversal" : "Triangle / Wedge"

f_wantFam(int id) => patFam == "All" or f_patFam(id) == patFam

if showPat and newPivot and not na(atr) and array.size(swX) >= 3
    int n = array.size(swX)
    int xA = array.get(swX, n - 3)
    int xB = array.get(swX, n - 2)
    int xC = array.get(swX, n - 1)
    float yA = array.get(swY, n - 3)
    float yB = array.get(swY, n - 2)
    float yC = array.get(swY, n - 1)
    int dA = array.get(swD, n - 3)
    int dB = array.get(swD, n - 2)
    int dC = array.get(swD, n - 1)
    bool drawn = false

    if dA == 1 and dB == -1 and dC == 1 and math.abs(yC - yA) <= patTol * atr and yA - yB > patMinH * atr and f_wantFam(13)
        f_pushPat(13, 0, 3, xA, yA, xB, yB, xC, yC, int(na), float(na), int(na), float(na))
        drawn := true
    if not drawn and dA == -1 and dB == 1 and dC == -1 and math.abs(yC - yA) <= patTol * atr and yB - yA > patMinH * atr and f_wantFam(9)
        f_pushPat(9, 0, 3, xA, yA, xB, yB, xC, yC, int(na), float(na), int(na), float(na))
        drawn := true

    if not drawn and n >= 5
        int a1 = array.get(swX, n - 5)
        int a2 = array.get(swX, n - 4)
        int a3 = array.get(swX, n - 3)
        int a4 = array.get(swX, n - 2)
        int a5 = array.get(swX, n - 1)
        float p1 = array.get(swY, n - 5)
        float p2 = array.get(swY, n - 4)
        float p3 = array.get(swY, n - 3)
        float p4 = array.get(swY, n - 2)
        float p5 = array.get(swY, n - 1)
        int q1 = array.get(swD, n - 5)
        int q3 = array.get(swD, n - 3)
        int q5 = array.get(swD, n - 1)
        if q1 == 1 and q3 == 1 and q5 == 1 and p3 > p1 and p3 > p5 and math.abs(p1 - p5) <= patTol * atr * 2 and math.min(p1, p5) - math.min(p2, p4) > patMinH * atr and f_wantFam(15)
            f_pushPat(15, 0, 5, a1, p1, a2, p2, a3, p3, a4, p4, a5, p5)
            drawn := true
        if not drawn and q1 == -1 and q3 == -1 and q5 == -1 and p3 < p1 and p3 < p5 and math.abs(p1 - p5) <= patTol * atr * 2 and math.max(p2, p4) - math.max(p1, p5) > patMinH * atr and f_wantFam(11)
            f_pushPat(11, 0, 5, a1, p1, a2, p2, a3, p3, a4, p4, a5, p5)
            drawn := true

    if not drawn and n >= 4
        array<int> hx = array.new_int()
        array<float> hy = array.new_float()
        array<int> lx = array.new_int()
        array<float> ly = array.new_float()
        for i = n - 4 to n - 1
            if array.get(swD, i) == 1
                array.push(hx, array.get(swX, i)), array.push(hy, array.get(swY, i))
            else
                array.push(lx, array.get(swX, i)), array.push(ly, array.get(swY, i))
        if array.size(hx) >= 2 and array.size(lx) >= 2
            float sH = f_slope(hx, hy)
            float sL = f_slope(lx, ly)
            int xa = math.min(array.get(hx, 0), array.get(lx, 0))
            int xb = bar_index + zoneExt
            float h0 = array.get(hy, 0)
            float l0 = array.get(ly, 0)
            float hA = h0 + sH * (xa - array.get(hx, 0))
            float lA = l0 + sL * (xa - array.get(lx, 0))
            float hB = h0 + sH * (xb - array.get(hx, 0))
            float lB = l0 + sL * (xb - array.get(lx, 0))
            float flat = atr * 0.15
            if math.abs(hA - lA) > patMinH * atr
                int id = 0
                if math.abs(sH) < flat and sL > flat
                    id := 1
                else if math.abs(sL) < flat and sH < -flat
                    id := 5
                else if sH < -flat and sL > flat
                    id := 4
                else if sH > flat and sL > flat and sH < sL
                    id := 12
                else if sH < -flat and sL < -flat and sH > sL
                    id := 16
                if id != 0 and f_wantFam(id)
                    f_pushPat(id, 1, 4, xa, hA, xb, hB, xa, lA, xb, lB, int(na), float(na))
                    drawn := true

    if not drawn and n >= 4
        int f1 = array.get(swX, n - 4)
        int f2 = array.get(swX, n - 3)
        int f3 = array.get(swX, n - 2)
        int f4 = array.get(swX, n - 1)
        float v1 = array.get(swY, n - 4)
        float v2 = array.get(swY, n - 3)
        float v3 = array.get(swY, n - 2)
        float v4 = array.get(swY, n - 1)
        int e1 = array.get(swD, n - 4)
        int e2 = array.get(swD, n - 3)
        int e3 = array.get(swD, n - 2)
        int e4 = array.get(swD, n - 1)
        float pole = math.abs(v2 - v1)
        bool bullPole = e1 == -1 and e2 == 1 and v2 > v1
        bool bearPole = e1 == 1 and e2 == -1 and v1 > v2
        if pole > 3.0 * atr and e3 != e4 and f4 > f3
            if bullPole and e3 == -1 and e4 == 1 and v3 > v1 and (v2 - v3) < 0.5 * pole and f_wantFam(3)
                f_pushPat(3, 0, 4, f1, v1, f2, v2, f3, v3, f4, v4, int(na), float(na))
                drawn := true
            if not drawn and bearPole and e3 == 1 and e4 == -1 and v3 < v1 and (v3 - v2) < 0.5 * pole and f_wantFam(7)
                f_pushPat(7, 0, 4, f1, v1, f2, v2, f3, v3, f4, v4, int(na), float(na))

// PASS 2 - RENDER
if barstate.islast
    f_clearAll()
    int right = bar_index + zoneExt

    // internal structure: dashed, tiny
    if showInt and array.size(iX1) > 0
        for i = 0 to array.size(iX1) - 1
            int kind = array.get(iKind, i)
            int dir = array.get(iDir, i)
            if (kind == 1 and showBOS) or (kind == 2 and showCHoCH)
                color hue = dir == 1 ? COL_GREEN : COL_RED
                f_line(array.get(iX1, i), array.get(iY, i), array.get(iX2, i), array.get(iY, i), hue, line.style_dashed, 1)
                f_lab(math.round((array.get(iX1, i) + array.get(iX2, i)) / 2), array.get(iY, i),
                     kind == 1 ? "BOS" : "CHoCH", hue,
                     dir == 1 ? label.style_label_down : label.style_label_up, size.tiny)

    // swing structure: solid, small
    if array.size(bX1) > 0
        for i = 0 to array.size(bX1) - 1
            int kind = array.get(bKind, i)
            int dir = array.get(bDir, i)
            if (kind == 1 and showBOS) or (kind == 2 and showCHoCH)
                color hue = dir == 1 ? COL_GREEN : COL_RED
                f_line(array.get(bX1, i), array.get(bY, i), array.get(bX2, i), array.get(bY, i), hue, line.style_solid, 1)
                f_lab(math.round((array.get(bX1, i) + array.get(bX2, i)) / 2), array.get(bY, i),
                     kind == 1 ? "BOS" : "CHoCH", hue,
                     dir == 1 ? label.style_label_down : label.style_label_up, size.small)

    // equal highs / lows - each swing compared with the previous swing of the
    // SAME kind, because a high is always followed by a low
    if (showEQH or showEQL) and not na(atr) and array.size(swX) > 0
        int prevHi = -1
        int prevLo = -1
        for i = 0 to array.size(swX) - 1
            int d = array.get(swD, i)
            int xi = array.get(swX, i)
            float yi = array.get(swY, i)
            if d == 1
                if prevHi >= 0 and showEQH
                    float yp = array.get(swY, prevHi)
                    int xp = array.get(swX, prevHi)
                    if math.abs(yi - yp) <= eqTol * atr and xi > xp
                        f_line(xp, yp, xi, yi, COL_RED, line.style_dotted, 1)
                        f_lab(math.round((xp + xi) / 2), math.max(yi, yp), "EQH", COL_RED, label.style_label_down, size.tiny)
                prevHi := i
            else
                if prevLo >= 0 and showEQL
                    float yp = array.get(swY, prevLo)
                    int xp = array.get(swX, prevLo)
                    if math.abs(yi - yp) <= eqTol * atr and xi > xp
                        f_line(xp, yp, xi, yi, COL_GREEN, line.style_dotted, 1)
                        f_lab(math.round((xp + xi) / 2), math.min(yi, yp), "EQL", COL_GREEN, label.style_label_up, size.tiny)
                prevLo := i

    // Strong / Weak highs and lows - trend-based: in a bullish trend the
    // standing high is the weak one and the standing low is strong
    if (showSWHigh or showSWLow) and not na(trTop) and not na(trBot)
        bool bullTrend = trend >= 0
        if showSWHigh
            f_line(trTopX, trTop, right, trTop, COL_RED, line.style_solid, 1)
            f_lab(right, trTop, bullTrend ? "Weak High" : "Strong High", COL_RED, label.style_label_down, size.tiny)
        if showSWLow
            f_line(trBotX, trBot, right, trBot, COL_GREEN, line.style_solid, 1)
            f_lab(right, trBot, bullTrend ? "Strong Low" : "Weak Low", COL_GREEN, label.style_label_up, size.tiny)

    // liquidity zones - the standing swing levels not yet taken
    if showLQZ and not na(atr) and not na(lastH) and not na(lastL)
        float pad = atr * 0.25
        if hTaken != lastHx
            f_box(lastHx, lastH + pad, right, lastH - pad, color.new(COL_RED, 88))
            f_zone(lastHx, lastH + pad, right, lastH - pad, "Liq", COL_RED)
        if lTaken != lastLx
            f_box(lastLx, lastL + pad, right, lastL - pad, color.new(COL_GREEN, 88))
            f_zone(lastLx, lastL + pad, right, lastL - pad, "Liq", COL_GREEN)

    // fair value gaps - white
    if showFVG and array.size(fX1) > 0
        for i = 0 to array.size(fX1) - 1
            int x = array.get(fX1, i)
            float t = array.get(fT, i)
            float b = array.get(fB, i)
            f_box(x, t, right, b, color.new(COL_WHITE, 88))
            f_zone(x, t, right, b, "FVG", COL_WHITE)

    // order blocks - white
    if showOB and array.size(oX1) > 0
        for i = 0 to array.size(oX1) - 1
            int x = array.get(oX1, i)
            float t = array.get(oT, i)
            float b = array.get(oB, i)
            f_box(x, t, right, b, color.new(COL_WHITE, 88))
            f_zone(x, t, right, b, "ODB", COL_WHITE)

    // supply and demand
    if showSD and array.size(sX1) > 0
        for i = 0 to array.size(sX1) - 1
            int x = array.get(sX1, i)
            float t = array.get(sT, i)
            float b = array.get(sB, i)
            bool up = array.get(sD, i) == 1
            color hue = up ? COL_GREEN : COL_RED
            f_box(x, t, right, b, color.new(hue, 88))
            f_zone(x, t, right, b, up ? "Demand" : "Supply", hue)

    // premium / discount + OTE on the trailing dealing range
    if showFib and not na(trTop) and not na(trBot) and trTop > trBot
        float rng = trTop - trBot
        float eq = trBot + rng * 0.5
        bool bull = trend >= 0
        color oteCol = bull ? COL_GREEN : COL_RED
        float lvA = bull ? trBot + rng * (1.0 - fibLo) : trBot + rng * fibLo
        float lvB = bull ? trBot + rng * (1.0 - fibHi) : trBot + rng * fibHi
        float oLo = math.min(lvA, lvB)
        float oHi = math.max(lvA, lvB)
        int lx = math.min(trTopX, trBotX)
        f_box(lx, trTop, right, eq, color.new(COL_RED, 88))
        f_box(lx, eq, right, trBot, color.new(COL_GREEN, 88))
        f_zone(lx, trTop, right, eq, "PREMIUM  sell", COL_RED)
        f_zone(lx, eq, right, trBot, "DISCOUNT  buy", COL_GREEN)
        if showOTE
            f_box(lx, oHi, right, oLo, color.new(oteCol, 74))
            f_zone(lx, oHi, right, oLo, "OTE " + str.tostring(fibLo, "#.###") + " - " + str.tostring(fibHi, "#.###"), oteCol)
        f_line(lx, eq, right, eq, COL_WHITE, line.style_dashed, 1)
        f_lab(right, eq, "Equilibrium", COL_WHITE, label.style_label_left, size.tiny)
        f_line(lx, lvA, right, lvA, color.new(COL_WHITE, 45), line.style_dotted, 1)
        f_line(lx, lvB, right, lvB, color.new(COL_WHITE, 45), line.style_dotted, 1)
        f_lab(right, lvA, str.tostring(fibLo, "#.###"), color.new(COL_WHITE, 35), label.style_label_left, size.tiny)
        f_lab(right, lvB, str.tostring(fibHi, "#.###"), color.new(COL_WHITE, 35), label.style_label_left, size.tiny)
        f_lab(right, trTop, "1.0", color.new(COL_WHITE, 25), label.style_label_left, size.tiny)
        f_lab(right, trBot, "0.0", color.new(COL_WHITE, 25), label.style_label_left, size.tiny)
        if showFibSD
            for k = 1 to 3
                float mult = k == 1 ? 0.5 : k == 2 ? 1.0 : 1.5
                float lvl = bull ? trBot - rng * mult : trTop + rng * mult
                f_line(lx, lvl, right, lvl, color.new(COL_WHITE, 45), line.style_dotted, 1)
                f_lab(right, lvl, "-" + str.tostring(mult, "#.#") + " SD", color.new(COL_WHITE, 30), label.style_label_left, size.tiny)

    // patterns - all white, no box, no Entry/TP/SL. The name sits in the
    // middle of the formation.
    if array.size(pId) > 0
        for i = 0 to array.size(pId) - 1
            int id = array.get(pId, i)
            float hiY = na
            float loY = na
            int firstX = array.get(pX1, i)
            int lastX = firstX
            if array.get(pKind, i) == 0
                int cnt = array.get(pN, i)
                for j = 1 to cnt - 1
                    int xa = j == 1 ? array.get(pX1, i) : j == 2 ? array.get(pX2, i) : j == 3 ? array.get(pX3, i) : array.get(pX4, i)
                    float ya = j == 1 ? array.get(pY1, i) : j == 2 ? array.get(pY2, i) : j == 3 ? array.get(pY3, i) : array.get(pY4, i)
                    int xb = j == 1 ? array.get(pX2, i) : j == 2 ? array.get(pX3, i) : j == 3 ? array.get(pX4, i) : array.get(pX5, i)
                    float yb = j == 1 ? array.get(pY2, i) : j == 2 ? array.get(pY3, i) : j == 3 ? array.get(pY4, i) : array.get(pY5, i)
                    f_line(xa, ya, xb, yb, COL_WHITE, line.style_solid, 2)
                    hiY := na(hiY) ? math.max(ya, yb) : math.max(hiY, math.max(ya, yb))
                    loY := na(loY) ? math.min(ya, yb) : math.min(loY, math.min(ya, yb))
                    lastX := xb
            else
                int xa = array.get(pX1, i)
                float hA = array.get(pY1, i)
                int xb = array.get(pX2, i)
                float hB = array.get(pY2, i)
                int xc = array.get(pX3, i)
                float lA = array.get(pY3, i)
                int xd = array.get(pX4, i)
                float lB = array.get(pY4, i)
                f_line(xa, hA, xb, hB, COL_WHITE, line.style_solid, 2)
                f_line(xc, lA, xd, lB, COL_WHITE, line.style_solid, 2)
                hiY := math.max(hA, hB)
                loY := math.min(lA, lB)
                lastX := math.max(xb, xd)
            if not na(hiY) and not na(loY)
                f_lab(math.round((firstX + lastX) / 2), (hiY + loY) / 2, f_patName(id), COL_WHITE, label.style_label_center, size.small)
